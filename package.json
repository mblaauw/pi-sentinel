{
  "name": "pi-sentinel",
  "version": "0.1.0",
  "description": "Autonomous Pi task workers for Kubernetes, GitLab and internal model routers",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "pi-sentinel": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/host.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "pi-sentinel": "tsx src/cli.ts",
    "schemas": "node --import tsx scripts/schemas.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@sinclair/typebox": "0.34.41",
    "commander": "14.0.2",
    "cron-parser": "5.4.0",
    "jiti": "2.7.0",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "zod-to-json-schema": "3.25.1"
  }
}
