{
  "$ref": "#/definitions/environment",
  "definitions": {
    "environment": {
      "type": "object",
      "properties": {
        "connections": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "gitlab",
                  "kubernetes",
                  "prometheus"
                ]
              },
              "baseUrl": {
                "type": "string",
                "format": "uri"
              },
              "tokenEnv": {
                "type": "string"
              },
              "readTokenEnv": {
                "type": "string"
              },
              "tokenFile": {
                "type": "string"
              },
              "caFile": {
                "type": "string"
              },
              "allowedProjects": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "allowedNamespaces": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "writableDeployments": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "botUserId": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "kind",
              "baseUrl"
            ],
            "additionalProperties": false
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "format": "uri"
              },
              "modelId": {
                "type": "string",
                "minLength": 1
              },
              "apiKeyEnv": {
                "type": "string"
              },
              "contextWindow": {
                "$ref": "#/definitions/environment/properties/connections/additionalProperties/properties/botUserId",
                "default": 65536
              },
              "maxOutputTokens": {
                "$ref": "#/definitions/environment/properties/connections/additionalProperties/properties/botUserId",
                "default": 4096
              },
              "reasoning": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "baseUrl",
              "modelId"
            ],
            "additionalProperties": false
          }
        },
        "policy": {
          "type": "object",
          "properties": {
            "allowAuto": {
              "type": "boolean",
              "default": false
            },
            "allowPublish": {
              "type": "boolean",
              "default": false
            },
            "maxCallsPerDay": {
              "$ref": "#/definitions/environment/properties/connections/additionalProperties/properties/botUserId",
              "default": 500
            },
            "maxTokensPerDay": {
              "$ref": "#/definitions/environment/properties/connections/additionalProperties/properties/botUserId",
              "default": 2000000
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "job": {
          "type": "object",
          "properties": {
            "activeDeadlineSeconds": {
              "$ref": "#/definitions/environment/properties/connections/additionalProperties/properties/botUserId",
              "default": 720
            },
            "startupSeconds": {
              "$ref": "#/definitions/environment/properties/connections/additionalProperties/properties/botUserId",
              "default": 30
            },
            "terminationSeconds": {
              "$ref": "#/definitions/environment/properties/connections/additionalProperties/properties/botUserId",
              "default": 30
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "connections",
        "models"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
