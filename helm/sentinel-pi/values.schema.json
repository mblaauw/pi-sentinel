{
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "not": {
            "const": "latest"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "configMapName": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": ["cron", "continuous", "once"]
        },
        "schedule": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "files": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "startingDeadlineSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "successfulHistory": {
          "type": "integer",
          "minimum": 0
        },
        "failedHistory": {
          "type": "integer",
          "minimum": 0
        },
        "ttlSecondsAfterFinished": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "cycleSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "startupSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 0
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "credentials": {
      "type": "object",
      "properties": {
        "envFromSecrets": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "caBundle": {
      "type": "object",
      "properties": {
        "configMapName": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "kubernetes": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespaces": {
          "type": "array"
        },
        "writeDeployments": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "egress": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 0
        },
        "ingressFrom": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "externalSecret": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "storeName": {
          "type": "string"
        },
        "refreshInterval": {
          "type": "string"
        },
        "keys": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["key", "property"],
            "properties": {
              "key": {
                "type": "string"
              },
              "property": {
                "type": "string"
              },
              "decodingStrategy": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
